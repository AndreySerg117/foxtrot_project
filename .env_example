# settings
SECRET_KEY='secret_key'
DEBUG=True
ALLOWED_HOSTS='127.0.0.1'

# neon tech
PGHOST='pghost'
PGDATABASE='neondb'
PGUSER='neondb_owner'
PGPASSWORD='password'

# S3
CLOUDFLARE_R2_BUCKET=foxtrot-project
CLOUDFLARE_R2_ACCESS_KEY=access_key
CLOUDFLARE_R2_SECRET_KEY=secret_key
CLOUDFLARE_R2_BUCKET_ENDPOINT=bucket

# Google Oauth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Browser-facing origin OAuth callbacks are built on (dev: Vite server)
OAUTH_REDIRECT_BASE=http://localhost:8000

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_google_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com